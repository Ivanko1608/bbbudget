# A per-user service: budgets live in each user's ~/.local/share/bbbudget.
# Enable with: systemctl --user enable --now bbbudget
# Change flags with: systemctl --user edit bbbudget
[Unit]
Description=bbbudget budget planner (web UI and MCP on 127.0.0.1:8080)
Documentation=https://github.com/Ivanko1608/bbbudget

[Service]
ExecStart=/usr/bin/bbbudget serve
Restart=on-failure

# Only seccomp-based hardening: it works in user services without extra privileges.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
