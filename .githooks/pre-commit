#!/bin/sh
# Scans staged changes for secrets and personal data before they're committed.
# Enable with `make hooks`. Bypass a false positive with `git commit --no-verify`,
# or silence it for good in .leakscanignore.
#
# The scanner is not vendored: point $LEAKSCAN at leakscan.py, or put it at
# ~/.local/share/leakscan/leakscan.py. Without it, this hook warns and allows
# the commit. A personal denylist (names, addresses, employer) is picked up from
# ~/.config/leakscan/denylist.txt; keep it out of the repo.

scanner=${LEAKSCAN:-"$HOME/.local/share/leakscan/leakscan.py"}
if [ ! -f "$scanner" ]; then
	echo "pre-commit: leakscan not found at $scanner, skipping the leak check" >&2
	exit 0
fi

if ! python3 "$scanner" "$(git rev-parse --show-toplevel)" --staged --fail-on medium; then
	echo >&2
	echo "pre-commit: leakscan blocked this commit. Review the findings above;" >&2
	echo "            'git commit --no-verify' overrides a false positive." >&2
	exit 1
fi
