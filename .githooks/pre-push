#!/bin/sh
# Blocks a push whose new commits carry a private author or committer email.
# The email is published with every commit, and the pre-commit leak scan only
# sees staged content, never commit metadata. Enable with `make hooks`. If an
# address is meant to be public, bypass with `git push --no-verify`.

# GitHub's noreply addresses: the per-user one and the one web merges use.
public_email='@users\.noreply\.github\.com$|^noreply@github\.com$'

# list_new_emails prints every author and committer email in the commits
# reachable from the given commit that no remote-tracking branch has yet.
list_new_emails() {
	git log --format='%ae%n%ce' "$1" --not --remotes | sort -u
}

is_deletion() {
	case $1 in
	*[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if is_deletion "$local_sha"; then
		continue
	fi
	private_emails=$(list_new_emails "$local_sha" | grep -Ev "$public_email")
	if [ -n "$private_emails" ]; then
		echo "pre-push: new commits on $local_ref use private emails:" >&2
		echo "$private_emails" | sed 's/^/    /' >&2
		blocked=1
	fi
done

if [ "$blocked" -eq 1 ]; then
	echo >&2
	echo "pre-push: set user.email to your GitHub noreply address and rewrite" >&2
	echo "          those commits, or bypass with 'git push --no-verify'." >&2
fi
exit $blocked
